{
  "name": "personal-website",
  "version": "3.0.0",
  "private": true,
  "type": "module",
  "description": "The personal website of Caleb Evans, coder for Christ.",
  "author": "Caleb Evans",
  "engines": {
    "node": "24.x"
  },
  "scripts": {
    "dev": "vite dev",
    "build": "vite build",
    "preview": "vite preview",
    "check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
    "check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
    "lint": "prettier --check . && eslint .",
    "format": "prettier --write .",
    "screenshot-websites": "tsx utilities/screenshot-websites.ts",
    "generate-social-preview": "tsx utilities/generate-social-preview.ts"
  },
  "dependencies": {
    "@fontsource-variable/roboto-flex": "^5.3.0",
    "es-toolkit": "^1.52.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@rollup/pluginutils": "^5.4.0",
    "@sveltejs/adapter-static": "^4.0.0",
    "@sveltejs/kit": "^3.0.0",
    "@sveltejs/vite-plugin-svelte": "^7.3.1",
    "@types/node": "^26.6.4",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-svelte": "^3.23.0",
    "glob": "^13.0.6",
    "globals": "^17.13.0",
    "imagetools-core": "^12.0.0",
    "marked": "^18.0.14",
    "mdsvex": "^0.12.8",
    "prettier": "^3.9.9",
    "prettier-plugin-svelte": "^4.1.1",
    "puppeteer": "^25.12.0",
    "sass-embedded": "^1.105.1",
    "schema-dts": "^2.1.0",
    "svelte": "5.57.1",
    "svelte-check": "^4.7.6",
    "svgo": "^4.1.0",
    "tslib": "^2.8.1",
    "tsx": "^4.23.15",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.71.0",
    "vite": "^8.3.2",
    "vite-imagetools": "^12.0.1",
    "vite-plugin-image-optimizer": "^2.0.3",
    "yaml": "^2.9.1"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "^12.0.0",
      "onFail": "ignore"
    }
  },
  "imports": {
    "#lib": "./src/lib/index.js",
    "#lib/*": "./src/lib/*"
  }
}
